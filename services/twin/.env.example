# Copy to .env (never commit .env)

# true = local mock + buttons | false = read-only from PostgreSQL
VITE_USE_MOCK=true
VITE_DEBUG_PANEL=true
VITE_POLL_MS=500

# Server-side only (scripts + Vite /api/state middleware)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- When VITE_USE_MOCK=false (database mode) ---
# Twin polls same-origin /api/state (built into npm run dev). Do NOT use VITE_STATE_URL.
# Optional override:
# VITE_DB_STATE_URL=/api/state

# --- When VITE_USE_MOCK=true (optional external state from vision service) ---
# VITE_STATE_URL=http://localhost:8000/state

# Camera stream (Phase 1)
VITE_VISION_STREAM_URL=http://localhost:8000/stream
