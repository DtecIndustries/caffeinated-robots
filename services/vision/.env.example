# ---- video source ----
# Leave VIDEO_SOURCE blank to use a local camera (CAMERA_INDEX).
VIDEO_SOURCE=https://cardigan-upper-polo.ngrok-free.dev/stream
# --- Camera source (pick one) ---
# Local USB webcam (use list_cams.py to find the right index)
CAMERA_INDEX=0
# ngrok-free serves an interstitial unless this header is present.
STREAM_HTTP_HEADERS="ngrok-skip-browser-warning: 1"

# ---- stream server (this box re-serves the processed feed) ----
# Remote MJPEG stream — set this instead if you have no local cam (e.g. teammate's ngrok URL)
# CAMERA_URL=https://xxxx.ngrok-free.app/stream

# --- Stream server ---
STREAM_HOST=0.0.0.0
STREAM_PORT=8000
STREAM_FPS=30
STREAM_WIDTH=640
STREAM_HEIGHT=480

# --- Detection ---
DETECTION_INTERVAL=0.5          # seconds between detection runs
DETECTION_CONFIRM_DELAY=1.0     # seconds object must be continuously visible before confirming as present
DETECTION_RATIO_THRESHOLD=0.32  # min fraction of ROI pixels that must be object (0.0–1.0)
DETECTION_BRIGHT_THRESH=220     # pixels above this = white/GOOD (raise to be stricter)
DETECTION_RANGE_THRESH=80       # min/max grey diff above this = object present but not white → FAULTY

# --- Robot ---
ROBOT_PORT=/dev/ttyUSB0       # serial port for Feetech servo bus
ROBOT_SERVO_IDS=1 2 3 4 5 6   # space-separated servo IDs on the bus

# --- Local buffer DB ---
SQLITE_PATH=local.db    # SQLite file path — always written, works offline

# --- Runner ---
RUNNER_POLL_INTERVAL=5.0  # seconds between DB polls in runner.py

# --- Database ---
# Leave commented out to skip DB writes entirely (useful for local testing)
# DB_URL=postgresql://user:pass@host:5432/dbname

# ---- YOLO segmentation ----
# Nano-seg keeps stream realtime
# every-2nd-frame leaves GPU headroom for the slow VLM pass.
YOLO_MODEL=yolo11n-seg.pt
YOLO_DEVICE=cuda:0
YOLO_IMGSZ=640
YOLO_CONF=0.35
YOLO_HALF=true
YOLO_EVERY_N=2

# ---- vLLM / Qwen2.5-VL ----
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct-AWQ
VLLM_API_KEY=EMPTY
VLM_MAX_TOKENS=192
VLM_TEMPERATURE=0.2
VLM_JPEG_MAX_SIDE=768
VLM_JPEG_QUALITY=80

# ---- pipeline gating ----
# Keep the floor generous so
# YOLO/stream stay smooth between VLM passes.
ENABLE_VLM=true
VLM_MIN_INTERVAL_S=3.0
VLM_HEARTBEAT_S=20.0

# ---- vLLM server launch (used by deploy/run_vllm.sh) ----
# vLLM starts before YOLO (see run_all.sh), so it can safely claim 0.60 of the
# 8GB; that gives the KV cache room while YOLO + display fit in the remainder.
VLLM_PORT=8001
VLLM_GPU_MEM_UTIL=0.60
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=1
# Cap image tokens to protect the tiny KV cache (pixels = max side^2-ish).
VLLM_MM_MAX_PIXELS=602112

# ---- ngrok tunnel (used by deploy/run_tunnel.sh) ----
# Get a token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional reserved domain, e.g. my-bot.ngrok-free.app (leave blank for random URL)
NGROK_DOMAIN=
