# --- Camera source (pick one) ---
# Local USB webcam (use list_cams.py to find the right index)
CAMERA_INDEX=0
# Remote MJPEG stream — set this instead if you have no local cam (e.g. teammate's ngrok URL)
# CAMERA_URL=https://xxxx.ngrok-free.app/stream

# --- Stream server ---
STREAM_HOST=0.0.0.0
STREAM_PORT=8000
STREAM_FPS=30
STREAM_WIDTH=640
STREAM_HEIGHT=480

# --- Detection ---
DETECTION_INTERVAL=0.5          # seconds between detection runs
DETECTION_RATIO_THRESHOLD=0.02  # min fraction of ROI pixels that must be object (0.0–1.0)
DETECTION_BRIGHT_THRESH=180     # grayscale cutoff for white objects (0–255, lower = more sensitive)
DETECTION_DARK_THRESH=50        # grayscale cutoff for black objects (0–255, higher = more sensitive)

# --- Database ---
# Leave commented out to skip DB writes entirely (useful for local testing)
# DB_URL=postgresql://user:pass@host:5432/dbname
